--- /dev/null
+++ b/test_solutions.py
@@ -0,0 +1,20 @@
+# Tests of the solution of chapter 27's exercise 2: histograms of how long
+# GET and SET took.
+from test_v15 import metrics_server, total
+
+
+# Check that each GET and SET is counted in its command's histogram, and
+# that no other command has one.
+def test_latency_histograms(start_server):
+    r, url, _ = metrics_server(start_server)
+    for i in range(5):
+        r.set(f'latency:{i}', i)
+    for i in range(3):
+        r.get(f'latency:{i}')
+    r.delete('latency:0')
+    for command, n in [('set', 5), ('get', 3)]:
+        assert total(url, 'shoal_commands_latency_count', command=command) == n
+        assert total(url, 'shoal_commands_latency_bucket', command=command,
+                     le='+Inf') == n
+        assert total(url, 'shoal_commands_latency_sum', command=command) > 0
+    assert total(url, 'shoal_commands_latency_count', command='del') == 0

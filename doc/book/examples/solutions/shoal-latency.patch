+// snippet: timed
+// Adds the time since start to the histogram, if there is one, when the
+// reply is ready: now, if it is, or else in a continuation.
+future<sstring> timed(future<sstring> reply, latency_histogram* latency,
+                      std::chrono::steady_clock::time_point start) {
+    if (!latency) {
+        return reply;
+    }
+    if (reply.available()) {
+        latency->add(std::chrono::steady_clock::now() - start);
+        return reply;
+    }
+    return reply.then([latency, start] (sstring r) {
+        latency->add(std::chrono::steady_clock::now() - start);
+        return r;
+    });
+}
+// end snippet: timed

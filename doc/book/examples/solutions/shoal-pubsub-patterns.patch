@@ -0,0 +1,66 @@
+# Tests for the solution of chapter 7's exercise 2: PSUBSCRIBE and
+# PUNSUBSCRIBE. They pass against Valkey too.
+import socket
+
+from test_v4 import bulk, command, confirmation, exchange, read_exactly, unique
+
+
+def pmessage(pattern, channel, message):
+    return b'*4\r\n' + bulk('pmessage') + bulk(pattern) + bulk(channel) + bulk(message)
+
+
+def message(channel, message):
+    return b'*3\r\n' + bulk('message') + bulk(channel) + bulk(message)
+
+
+# Check that PSUBSCRIBE confirms each pattern, and that patterns and
+# channels are counted together.
+def test_psubscribe_confirmations(server):
+    p = unique('news') + '.*'
+    exchange(server, ('PSUBSCRIBE', p, 'x?'), ('SUBSCRIBE', 'y'),
+             expect=confirmation('psubscribe', p, 1) + confirmation('psubscribe', 'x?', 2)
+             + confirmation('subscribe', 'y', 3))
+
+
+# Check that a pattern subscriber receives a pmessage for a matching channel,
+# and nothing for a channel that doesn't match.
+def test_publish_to_pattern(server, r):
+    prefix = unique('news')
+    with socket.create_connection(server, timeout=5) as s:
+        s.sendall(command('PSUBSCRIBE', prefix + '.*'))
+        read_exactly(s, len(confirmation('psubscribe', prefix + '.*', 1)))
+        assert r.publish(prefix + 'x', 'no') == 0
+        assert r.publish(prefix + '.sports', 'hi') == 1
+        expected = pmessage(prefix + '.*', prefix + '.sports', 'hi')
+        assert read_exactly(s, len(expected)) == expected
+
+
+# Check that a client subscribed to a channel, and to a pattern that matches
+# it, receives the message twice, and PUBLISH counts it twice.
+def test_channel_and_pattern(server, r):
+    channel = unique('news')
+    with socket.create_connection(server, timeout=5) as s:
+        s.sendall(command('SUBSCRIBE', channel) + command('PSUBSCRIBE', channel[:-2] + '*'))
+        read_exactly(s, len(confirmation('subscribe', channel, 1))
+                     + len(confirmation('psubscribe', channel[:-2] + '*', 2)))
+        assert r.publish(channel, 'hi') == 2
+        expected = message(channel, 'hi') + pmessage(channel[:-2] + '*', channel, 'hi')
+        assert read_exactly(s, len(expected)) == expected
+
+
+# Check PUNSUBSCRIBE of one pattern, of all patterns, and without any.
+def test_punsubscribe(server):
+    exchange(server, ('PUNSUBSCRIBE',), expect=confirmation('punsubscribe', None, 0))
+    exchange(server, ('PSUBSCRIBE', 'a*', 'b*'), ('SUBSCRIBE', 'c'), ('PUNSUBSCRIBE', 'a*'),
+             expect=confirmation('psubscribe', 'a*', 1) + confirmation('psubscribe', 'b*', 2)
+             + confirmation('subscribe', 'c', 3) + confirmation('punsubscribe', 'a*', 2))
+
+
+# Check that a client subscribed only to a pattern is in the subscribed
+# mode: PING gets an array, and GET an error.
+def test_pattern_subscribed_mode(server):
+    with socket.create_connection(server, timeout=5) as s:
+        s.sendall(command('PSUBSCRIBE', 'z*') + command('PING') + command('GET', 'k'))
+        expected = (confirmation('psubscribe', 'z*', 1)
+                    + b'*2\r\n' + bulk('pong') + bulk('') + b'-ERR Can')
+        assert read_exactly(s, len(expected)) == expected

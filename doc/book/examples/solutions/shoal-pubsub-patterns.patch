+// snippet: psubscribe
+// PSUBSCRIBE pattern [pattern ...]
+future<> pubsub::psubscribe(client& c, const request& req) {
+    if (req.size() < 2) {
+        co_return co_await c.write(wrong_arguments("psubscribe"));
+    }
+    for (size_t i = 1; i < req.size(); i++) {
+        if (c.patterns().insert(req[i]).second) {
+            _patterns[req[i]].insert(&c);
+        }
+        c.send(confirmation("psubscribe", &req[i], c.subscriptions()));
+    }
+    co_await c.drain();
+}
+
+void pubsub::remove_pattern(client& c, const sstring& pattern) {
+    c.patterns().erase(pattern);
+    auto it = _patterns.find(pattern);
+    if (it != _patterns.end()) {
+        it->second.erase(&c);
+        if (it->second.empty()) {
+            _patterns.erase(it);
+        }
+    }
+}
+
+// PUNSUBSCRIBE [pattern ...]
+future<> pubsub::punsubscribe(client& c, const request& req) {
+    if (req.size() == 1) {
+        if (c.patterns().empty()) {
+            c.send(confirmation("punsubscribe", nullptr, c.subscriptions()));
+        }
+        std::vector<sstring> all(c.patterns().begin(), c.patterns().end());
+        for (auto& pattern : all) {
+            remove_pattern(c, pattern);
+            c.send(confirmation("punsubscribe", &pattern, c.subscriptions()));
+        }
+    }
+    for (size_t i = 1; i < req.size(); i++) {
+        remove_pattern(c, req[i]);
+        c.send(confirmation("punsubscribe", &req[i], c.subscriptions()));
+    }
+    co_await c.drain();
+}
+// end snippet: psubscribe
+
 void pubsub::forget(client& c) {
     std::vector<sstring> all(c.channels().begin(), c.channels().end());
     for (auto& channel : all) {
         remove(c, channel);
     }
+    std::vector<sstring> patterns(c.patterns().begin(), c.patterns().end());
+    for (auto& pattern : patterns) {
+        remove_pattern(c, pattern);
+    }
 }


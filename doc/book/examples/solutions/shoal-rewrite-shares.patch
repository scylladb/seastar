+# Tests for the solution of exercise 3 of "Scheduling groups":
+# REWRITESHARES sets the rewrite group's shares. Valkey has no such
+# command, so these tests run only against Shoal.
+import time
+
+import pytest
+import redis
+
+
+# Check that REWRITESHARES accepts shares from 1 to 10000, and refuses
+# anything else.
+def test_rewriteshares(r, start_server):
+    if start_server.is_valkey:
+        pytest.skip('Valkey has no REWRITESHARES')
+    assert r.execute_command('REWRITESHARES', '10') == b'OK'
+    assert r.execute_command('REWRITESHARES', '1000') == b'OK'
+    for bad in ['0', '10001', 'x']:
+        with pytest.raises(redis.ResponseError):
+            r.execute_command('REWRITESHARES', bad)
+    assert r.execute_command('REWRITESHARES', '100') == b'OK'
+
+
+# Check that a rewrite still finishes, and keeps the data, when its shares
+# change while it runs.
+def test_rewriteshares_during_rewrite(r, start_server):
+    if start_server.is_valkey:
+        pytest.skip('Valkey has no REWRITESHARES')
+    p = r.pipeline(transaction=False)
+    for i in range(20000):
+        p.set(f'rs{i}', 'v')
+    p.execute()
+    assert r.bgrewriteaof()
+    r.execute_command('REWRITESHARES', '10')
+    r.execute_command('REWRITESHARES', '1000')
+    deadline = time.time() + 60
+    while r.info('persistence')['aof_rewrite_in_progress']:
+        assert time.time() < deadline
+        time.sleep(0.01)
+    assert r.get('rs19999') == b'v'
+    r.execute_command('REWRITESHARES', '100')

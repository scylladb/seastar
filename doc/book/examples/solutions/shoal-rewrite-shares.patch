+// REWRITESHARES n: sets the rewrite group's shares, on every shard, since
+// set_shares() changes them only on the shard that calls it. It takes
+// effect at once, even in the middle of a rewrite.
+future<std::optional<reply>> rewriteshares(sharded<store>& db, request req,
+                                             abort_source&) {
+    auto n = parse_integer(req[1]);
+    if (!n || *n < 1 || *n > 10000) {
+        co_return error_reply("shares must be an integer from 1 to 10000");
+    }
+    co_await db.invoke_on_all([shares = float(*n)] (store& s) {
+        s.groups.rewrite.set_shares(shares);
+    });
+    co_return simple_string_reply("OK");
+}
+// end snippet: rewriteshares

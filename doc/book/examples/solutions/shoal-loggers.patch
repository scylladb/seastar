+// snippet: loggers
+// GET /v1/loggers: every logger, and its level.
+json::json_return_type get_loggers() {
+    auto& registry = global_logger_registry();
+    std::vector<aj::logger_level> loggers;
+    for (auto& name : registry.get_all_logger_names()) {
+        aj::logger_level logger;
+        logger.name = name;
+        logger.level = fmt::to_string(registry.get_logger_level(name));
+        loggers.push_back(std::move(logger));
+    }
+    return loggers;
+}
+
+// PUT /v1/loggers/{name}?level=debug: sets the logger's level. A logger is
+// shared by all the shards, and its level is an atomic variable, so this
+// shard sets it for all of them.
+json::json_return_type set_logger_level(const http::request& req) {
+    auto name = req.get_path_param("name");
+    log_level level;
+    std::istringstream in(req.get_query_param("level"));
+    if (!(in >> level)) {
+        throw httpd::bad_param_exception(fmt::format(
+            "unknown level '{}'", req.get_query_param("level")));
+    }
+    try {
+        global_logger_registry().set_logger_level(name, level);
+    } catch (std::out_of_range&) {
+        throw httpd::not_found_exception(fmt::format("no logger '{}'", name));
+    }
+    return json::json_void();
+}
+// end snippet: loggers
+
 } // anonymous namespace


--- /dev/null
+++ b/test_solutions.py
@@ -0,0 +1,45 @@
+# Tests of the solution of chapter 27's exercise 1: the admin API lists the
+# loggers and sets their levels.
+import json
+import urllib.error
+import urllib.request
+
+import pytest
+
+from test_v13 import admin_server
+
+
+def call(url, method='GET'):
+    """The HTTP status and the decoded JSON reply, or None if it's empty."""
+    request = urllib.request.Request(url, method=method)
+    try:
+        with urllib.request.urlopen(request, timeout=10) as reply:
+            status, body = reply.status, reply.read()
+    except urllib.error.HTTPError as e:
+        status, body = e.code, e.read()
+    return status, json.loads(body) if body else None
+
+
+def levels(api):
+    status, loggers = call(f'{api}/v1/loggers')
+    assert status == 200
+    return {l['name']: l['level'] for l in loggers}
+
+
+# Check that the loggers are listed, Shoal's and Seastar's, and that a
+# logger's level can be changed while Shoal runs.
+def test_set_level(start_server):
+    _, api = admin_server(start_server)
+    before = levels(api)
+    assert before['shoal'] == 'info' and 'seastar' in before
+    status, _ = call(f'{api}/v1/loggers/shoal?level=debug', 'PUT')
+    assert status == 200
+    assert levels(api)['shoal'] == 'debug'
+
+
+# Check that an unknown logger, or an unknown level, is refused.
+def test_set_level_errors(start_server):
+    _, api = admin_server(start_server)
+    assert call(f'{api}/v1/loggers/nosuch?level=debug', 'PUT')[0] == 404
+    assert call(f'{api}/v1/loggers/shoal?level=loud', 'PUT')[0] == 400
+    assert levels(api)['shoal'] == 'info'

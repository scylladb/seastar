 // Deletes a key, and its expiration time.
+// snippet: lazy-free
+// Destroys a large list gradually, in the background, as FLUSHALL ASYNC
+// destroys the old table, so that deleting it doesn't stall the shard.
+future<> destroy_list_gently(gate& background, list_ptr list) {
+    auto working = background.hold();
+    while (!list->empty() && !background.is_closed()) {
+        list->pop_back();
+        co_await coroutine::maybe_yield();
+    }
+}
+
+// Called before a key's value is destroyed: takes a large list out of it,
+// and destroys it in the background. A small one is destroyed with the
+// value, at once, which is quicker. When Shoal is stopping, so is the
+// background work, and the list is destroyed at once too.
+void free_lazily(store& db, entry& e) {
+    constexpr size_t large = 1000;
+    auto* l = std::get_if<list_ptr>(&e.value);
+    if (l && (*l)->size() > large && !db.background.is_closed()) {
+        (void)destroy_list_gently(db.background, std::move(*l));
+    }
+}
+// end snippet: lazy-free
+
 void erase_key(store& db, key_table<entry>::iterator it) {
     persist_key(db, it->second);
     db.used_memory -= it->second.footprint;
+    // snippet: erase-lazily
+    free_lazily(db, it->second);
     db.data.erase(it);
+    // end snippet: erase-lazily
 }


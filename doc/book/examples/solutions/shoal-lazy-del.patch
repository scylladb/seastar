+# Tests for the solution of chapter 22's exercise 1: DEL, SET and the
+# other commands that destroy a large list destroy it in the background.
+# Like all of Shoal's tests, they pass against Valkey too, which by default
+# does the same (its lazyfree-lazy-user-del option).
+import pytest
+import redis
+
+from test_v8 import unique_key
+
+
+def push_many(r, key, n):
+    p = r.pipeline(transaction=False)
+    for i in range(0, n, 1000):
+        p.rpush(key, *[f'element-{j}' for j in range(i, min(i + 1000, n))])
+    p.execute()
+
+
+# snippet: tests
+# Check that a deleted large list is gone at once, for every command, even
+# while it's still being destroyed, and that a new list with the same key
+# starts empty.
+def test_del_large_list(r):
+    key = unique_key()
+    push_many(r, key, 200000)
+    assert r.delete(key) == 1
+    assert r.exists(key) == 0
+    assert r.llen(key) == 0
+    assert r.rpush(key, 'new') == 1
+    assert r.lrange(key, 0, -1) == [b'new']
+    r.delete(key)
+
+
+# Check that SET over a large list replaces it with the string at once.
+def test_set_over_large_list(r):
+    key = unique_key()
+    push_many(r, key, 200000)
+    assert r.set(key, 'string')
+    assert r.get(key) == b'string'
+    r.delete(key)
+
+
+# Check that SHUTDOWN, right after deleting large lists, which may still
+# be being destroyed in the background, stops the server cleanly.
+def test_stop_while_destroying(own_server):
+    r = redis.Redis(*own_server.address)
+    for i in range(5):
+        push_many(r, f'list{i}', 200000)
+    r.delete(*[f'list{i}' for i in range(5)])
+    assert r.dbsize() == 0
+    with pytest.raises(redis.exceptions.ConnectionError):
+        r.execute_command('SHUTDOWN')
+    assert own_server.process.wait(timeout=10) == 0
+# end snippet: tests

+// snippet: scan
+// snippet: scan-here
+// SCAN cursor [MATCH pattern] [COUNT count]. The cursor says where to
+// continue: in its lowest 8 bits, the shard (so Shoal may have at most 256
+// shards), and in the others, a position of the shard's key_table::scan(),
+// the first hash of a small table, whose lowest bits are always 0. A
+// position stays right however the table grows, so the scan never starts
+// over, and returns each key that exists throughout exactly once.
+struct scan_cursor {
+    unsigned shard = 0;
+    size_t position = 0;
+    static scan_cursor decode(uint64_t c) {
+        return {unsigned(c & 0xff), size_t(c & ~uint64_t(0xff))};
+    }
+    uint64_t encode() const {
+        return shard | position;
+    }
+};
+
+// What one shard found: its keys, and where to continue on it, if it
+// hasn't been scanned to the end.
+struct scan_result {
+    std::vector<sstring> keys;
+    std::optional<scan_cursor> next;
+};
+
+// Scans this shard's small tables, from the cursor's, until it finds count
+// keys, or reaches the end of the table.
+scan_result scan_here(store& db, scan_cursor c, const sstring& pattern,
+                      size_t count) {
+    scan_result result;
+    size_t position = c.position;
+    do {
+        position = db.data.scan(position, [&] (auto& element) {
+            auto& [key, e] = element;
+            if (glob_match(pattern, key) && !expired(e)) {
+                result.keys.emplace_back(key.data(), key.size());
+            }
+        });
+    } while (position != 0 && result.keys.size() < count);
+    if (position != 0) {
+        result.next = scan_cursor{c.shard, position};
+    }
+    return result;
+}
+// end snippet: scan-here
+
+future<std::optional<reply>> scan(sharded<store>& db, request req,
+                                  abort_source&) {
+    uint64_t cursor;
+    auto first = req[1].data(), last = first + req[1].size();
+    auto [end, error] = std::from_chars(first, last, cursor);
+    if (error != std::errc() || end != last) {
+        co_return error_reply("invalid cursor");
+    }
+    sstring pattern = "*";
+    size_t count = 10;
+    for (size_t i = 2; i < req.size(); i += 2) {
+        auto option = lowercase(req[i]);
+        bool known = option == "match" || option == "count";
+        if (i + 1 == req.size() || !known) {
+            co_return error_reply("syntax error");
+        }
+        if (option == "match") {
+            pattern = req[i + 1];
+        } else {
+            auto n = parse_integer(req[i + 1]);
+            if (!n || *n < 1) {
+                co_return error_reply("syntax error");
+            }
+            count = *n;
+        }
+    }
+    auto c = scan_cursor::decode(cursor);
+    if (c.shard >= this_smp_shard_count()) {
+        co_return error_reply("invalid cursor");
+    }
+    auto result = co_await db.invoke_on(c.shard, [&] (store& s) {
+        return scan_here(s, c, pattern, count);
+    });
+    // Continue on this shard, or on the next one, or, after the last one,
+    // tell the client that it's done, with the cursor 0.
+    uint64_t next = 0;
+    if (result.next) {
+        next = result.next->encode();
+    } else if (c.shard + 1 < this_smp_shard_count()) {
+        next = scan_cursor{c.shard + 1, 0}.encode();
+    }
+    std::string reply = array_header_reply(2)
+        + bulk_string_reply(to_sstring(next))
+        + array_header_reply(result.keys.size());
+    for (auto& key : result.keys) {
+        reply += bulk_string_reply(key);
+    }
+    co_return sstring(reply);
+}
+// end snippet: scan

+# Tests for the solution of chapter 20's exercise 1: SCAN, which lists the
+# keys a few at a time, with a cursor, on all the shards, and never starts
+# over. Like all of Shoal's tests, they pass against Valkey too.
+import pytest
+import redis
+
+from test_v8 import unique_key
+
+
+# Calls SCAN until the cursor is 0 again, calling between() after each
+# call, and returns all the keys it returned, with repetitions.
+def scan_all(r, match, count=10, between=lambda: None):
+    keys = []
+    cursor = 0
+    while True:
+        cursor, found = r.scan(cursor, match=match, count=count)
+        keys += [k.decode() for k in found]
+        between()
+        if cursor == 0:
+            return keys
+
+
+# Check that SCAN returns every matching key, and no other.
+def test_scan_all_keys(r):
+    prefix = unique_key()
+    keys = {f'{prefix}-{i}' for i in range(200)}
+    r.mset({k: 'x' for k in keys})
+    r.set(unique_key(), 'not matching')
+    assert set(scan_all(r, f'{prefix}-*')) == keys
+    r.delete(*keys)
+
+
+# Check that keys that exist throughout a scan are all returned, even when
+# many keys are added between the first calls, which makes the server's
+# tables grow. (Not between all of them: a scan of keys that are added
+# faster than it lists them may never end.)
+def test_scan_while_adding(r):
+    prefix = unique_key()
+    stable = {f'{prefix}-stable-{i}' for i in range(200)}
+    r.mset({k: 'x' for k in stable})
+    added = []
+
+    def add():
+        if len(added) < 5000:
+            new = [f'{prefix}-new-{len(added) + i}' for i in range(500)]
+            r.mset({k: 'x' for k in new})
+            added.extend(new)
+    found = set(scan_all(r, f'{prefix}-*', between=add))
+    assert stable <= found
+    r.delete(*stable, *added)
+
+
+# snippet: once
+# Check that while the tables grow, a scan returns each key that exists
+# throughout exactly once: it never starts over. (Redis promises only "at
+# least once", but returns a key twice only when its tables shrink.)
+def test_scan_while_adding_once(r):
+    prefix = unique_key()
+    stable = [f'{prefix}-stable-{i}' for i in range(200)]
+    r.mset({k: 'x' for k in stable})
+    added = []
+
+    def add():
+        if len(added) < 20000:
+            new = [f'{prefix}-new-{len(added) + i}' for i in range(2000)]
+            r.mset({k: 'x' for k in new})
+            added.extend(new)
+    found = scan_all(r, f'{prefix}-stable-*', count=50, between=add)
+    assert sorted(found) == sorted(stable)
+    r.delete(*stable, *added)
+# end snippet: once
+
+
+# Check that SCAN rejects a cursor that isn't a number, and an option that
+# it doesn't know, or a COUNT that isn't positive.
+def test_scan_errors(r):
+    with pytest.raises(redis.ResponseError, match='invalid cursor'):
+        r.execute_command('SCAN', 'abc')
+    with pytest.raises(redis.ResponseError, match='syntax error'):
+        r.execute_command('SCAN', '0', 'SIZE', '10')
+    with pytest.raises(redis.ResponseError, match='syntax error'):
+        r.execute_command('SCAN', '0', 'COUNT', '0')

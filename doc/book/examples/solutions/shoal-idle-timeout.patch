@@ -0,0 +1,57 @@
+# Tests for the solution of chapter 9's exercise 2: --timeout, which closes
+# the connection of a client that sends nothing for a while. test/run
+# starts the server, Shoal or Valkey, with a timeout of 2 seconds. Like
+# all of Shoal's tests, they pass against Valkey too.
+import socket
+import time
+
+import redis
+
+# The servers' timeout, which test/run sets, in seconds.
+TIMEOUT = 2
+
+
+# Returns a socket connected to the server, which reads with a timeout.
+def connect(server):
+    s = socket.create_connection(server)
+    s.settimeout(10)
+    return s
+
+
+# Waits for the server to close the connection, and returns how long it
+# took, or None if the server sent something else.
+def wait_for_close(s):
+    start = time.monotonic()
+    data = s.recv(100)
+    return time.monotonic() - start if data == b'' else None
+
+
+# Check that the server closes a connection that sends nothing, after the
+# timeout, but not long before it.
+def test_idle_connection_closed(server):
+    with connect(server) as s:
+        s.sendall(b'PING\r\n')
+        assert s.recv(100) == b'+PONG\r\n'
+        waited = wait_for_close(s)
+        assert waited is not None and TIMEOUT - 0.5 < waited < TIMEOUT + 2
+
+
+# Check that a connection that sends a request now and then, more often
+# than the timeout, stays open, although it lives longer than the timeout.
+def test_active_connection_stays_open(server):
+    with connect(server) as s:
+        for _ in range(8):
+            s.sendall(b'PING\r\n')
+            assert s.recv(100) == b'+PONG\r\n'
+            time.sleep(TIMEOUT / 4)
+
+
+# Check that a subscriber isn't disconnected, however long it waits for
+# messages, and receives a message published after the timeout.
+def test_subscriber_not_closed(r, server):
+    with connect(server) as s:
+        s.sendall(b'SUBSCRIBE idle-test-channel\r\n')
+        assert s.recv(100).startswith(b'*3\r\n$9\r\nsubscribe\r\n')
+        time.sleep(TIMEOUT + 1.5)
+        assert r.publish('idle-test-channel', 'hello') == 1
+        assert s.recv(100).endswith(b'$5\r\nhello\r\n')

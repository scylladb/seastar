+// snippet: seal
+// Before the first request of a commit, leaves room for its header.
+void append_only_log::begin_append() {
+    if (_size == _commit_start) {
+        copy(commit_header(0, 0));
+    }
+}
+
+// Fills in the header of the commit about to be written, with the length
+// and the checksum of its requests.
+void append_only_log::seal_commit() {
+    if (_size == _commit_start) {
+        return;     // only a failed write to retry, and no new requests
+    }
+    auto begin = _commit_start + header_size;
+    boost::crc_32_type crc;
+    for (auto pos = begin; pos < _size; ) {
+        auto& chunk = _tail[(pos - _tail_start) / chunk_size];
+        auto in_chunk = (pos - _tail_start) % chunk_size;
+        auto n = std::min<uint64_t>(_size - pos, chunk_size - in_chunk);
+        crc.process_bytes(chunk.get() + in_chunk, n);
+        pos += n;
+    }
+    auto header = commit_header(_size - begin, crc.checksum());
+    auto at = _commit_start - _tail_start;
+    std::memcpy(_tail[at / chunk_size].get_write() + at % chunk_size,
+                header.data(), header_size);
+}
+// end snippet: seal

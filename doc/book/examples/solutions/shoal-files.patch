 // The size of the chunks that hold the requests not yet written: a
 // multiple of any disk's alignment.
 constexpr size_t chunk_size = 128 * 1024;

+// snippet: commit-header
+// Every commit begins with a header, a request that replaying skips:
+// COMMIT, with the length of the commit's requests, and their checksum, in
+// hexadecimal, so that the header always has the same size.
+sstring commit_header(uint32_t length, uint32_t checksum) {
+    return fmt::format("*3\r\n$6\r\nCOMMIT\r\n"
+                       "$8\r\n{:08x}\r\n$8\r\n{:08x}\r\n", length, checksum);
+}
+constexpr size_t header_size = 44;
+
+// Reads 8 hexadecimal digits.
+std::optional<uint32_t> parse_hex(std::string_view s) {
+    uint32_t n;
+    auto [end, ec] = std::from_chars(s.data(), s.data() + s.size(), n, 16);
+    if (ec != std::errc() || end != s.data() + s.size()) {
+        return std::nullopt;
+    }
+    return n;
+}
+
+// If a whole commit, with a valid checksum, begins at pos, returns its
+// length, header included.
+future<std::optional<uint64_t>> valid_commit(file& f, uint64_t pos,
+                                             uint64_t size) {
+    if (size - pos < header_size) {
+        co_return std::nullopt;
+    }
+    auto buf = co_await f.dma_read_exactly<char>(pos, header_size);
+    std::string_view h(buf.get(), header_size);
+    auto length = parse_hex(h.substr(20, 8));
+    auto checksum = parse_hex(h.substr(34, 8));
+    if (!length || !checksum ||
+            h != std::string_view(commit_header(*length, *checksum)) ||
+            *length > size - pos - header_size) {
+        co_return std::nullopt;
+    }
+    boost::crc_32_type crc;
+    if (*length) {
+        auto body = co_await f.dma_read_exactly<char>(pos + header_size,
+                                                      *length);
+        crc.process_bytes(body.get(), body.size());
+    }
+    if (crc.checksum() != *checksum) {
+        co_return std::nullopt;
+    }
+    co_return header_size + *length;
+}
+
+// Finds where the log's valid commits end. If something follows that's
+// not a valid commit, a crash in the middle of a write left it, and it's
+// cut off; but if a valid commit follows it, the damage is in the
+// middle, which a crash doesn't do, and Shoal refuses to start, rather
+// than lose the commits after it, as Redis does.
+future<uint64_t> check_commits(file& f, sstring path) {
+    auto size = co_await f.size();
+    auto align = f.disk_write_dma_alignment();
+    uint64_t end = 0;
+    while (auto length = co_await valid_commit(f, end, size)) {
+        end = align_up(end + *length, align);
+    }
+    if (end >= size) {
+        co_return size;
+    }
+    for (auto pos = end + align; pos < size; pos += align) {
+        if (co_await valid_commit(f, pos, size)) {
+            co_await coroutine::return_exception(std::runtime_error(
+                fmt::format("{} is damaged at {}, and has valid commits "
+                            "after the damage, at {}", path, end, pos)));
+        }
+    }
+    shoal_log.warn("{}: its last commit is damaged; cutting off its last "
+                   "{} bytes", path, size - end);
+    co_await f.truncate(end);
+    co_await f.flush();
+    co_return end;
+}
+// end snippet: commit-header

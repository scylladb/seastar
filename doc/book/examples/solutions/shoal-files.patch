+    future<size_t> fail() {
+        return make_exception_future<size_t>(std::system_error(
+            EIO, std::system_category(), "a failing file"));
+    }
+public:
+    failing_file(file f, int fail_after)
+        : layered_file_impl(std::move(f)), _writes_left(fail_after) {}
+    future<size_t> write_dma(uint64_t pos, const void* buffer, size_t len,
+                             io_intent* intent) override {
+        if (_writes_left-- <= 0) {
+            return fail();
+        }
+        return _underlying_file.dma_write(
+            pos, static_cast<const char*>(buffer), len, intent);
+    }
+    future<size_t> write_dma(uint64_t pos, std::vector<iovec> iov,
+                             io_intent* intent) override {
+        if (_writes_left-- <= 0) {
+            return fail();
+        }
+        return _underlying_file.dma_write(pos, std::move(iov), intent);
+    }
+    // end snippet: failing-file
+    future<size_t> read_dma(uint64_t pos, void* buffer, size_t len,

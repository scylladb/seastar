+# Tests of the solutions to chapter 17's exercises 2, 3 and 4. The first
+# passes against Valkey too; the others test Shoal's own log format and
+# its own test option, so they need Shoal.
+import signal
+import socket
+import time
+from pathlib import Path
+
+import pytest
+import redis
+
+from test_v9 import command
+from test_v10 import persistent, stop
+
+
+def shoal_only(start_server):
+    if start_server.is_valkey:
+        pytest.skip("tests Shoal's own log")
+
+
+# snippet: pipeline-test
+# Check that a huge pipeline of SETs, with --appendfsync always, gets all
+# its replies, and that all its SETs survive a crash.
+def test_huge_pipeline_always(start_server, tmp_path):
+    srv, r = persistent(start_server, tmp_path, 'always')
+    n = 100_000
+    pipeline = b''.join(command('SET', f'k{i}', str(i)) for i in range(n))
+    with socket.create_connection(srv.address, timeout=30) as s:
+        s.sendall(pipeline)
+        data = b''
+        while data.count(b'\r\n') < n:
+            more = s.recv(1 << 20)
+            assert more, 'the server closed the connection'
+            data += more
+    assert data == b'+OK\r\n' * n
+    stop(srv, signal.SIGKILL)
+    srv, r = persistent(start_server, tmp_path, 'always')
+    assert r.dbsize() == n
+    assert r.get(f'k{n - 1}') == str(n - 1).encode()
+    stop(srv)
+# end snippet: pipeline-test
+
+
+# SETs a hundred keys of one shard (the hash tag decides it), one commit
+# each, kills the server, and returns the keys, and the shard's log.
+def hundred_commits(start_server, tmp_path):
+    srv, r = persistent(start_server, tmp_path, 'always')
+    keys = [f'{{t}}k{i}' for i in range(100)]
+    for k in keys:
+        r.set(k, 'v')
+    stop(srv, signal.SIGKILL)
+    [log] = [p for p in Path(tmp_path).glob('*.aof') if p.stat().st_size]
+    return keys, log
+
+
+def damage(log, pos):
+    with open(log, 'r+b') as f:
+        f.seek(pos)
+        byte = f.read(1)
+        f.seek(pos)
+        f.write(bytes([byte[0] ^ 0xff]))
+
+
+# Check that a log whose last commit is damaged, as a crash in the middle
+# of its write leaves it, is cut before that commit, and that the commits
+# before it survive.
+def test_damaged_end(start_server, tmp_path):
+    shoal_only(start_server)
+    keys, log = hundred_commits(start_server, tmp_path)
+    size = log.stat().st_size
+    assert size == 100 * 4096      # a block for each commit
+    damage(log, size - 4096 + 50)
+    srv, r = persistent(start_server, tmp_path, 'always')
+    assert r.mget(keys) == [b'v'] * 99 + [None]
+    stop(srv)
+
+
+# Check that a log damaged in the middle, with valid commits after the
+# damage, which a crash doesn't do, makes Shoal refuse to start, rather
+# than cut off the commits after the damage.
+def test_damaged_middle(start_server, tmp_path):
+    shoal_only(start_server)
+    keys, log = hundred_commits(start_server, tmp_path)
+    damage(log, 50 * 4096 + 50)
+    with pytest.raises(AssertionError, match='did not start'):
+        persistent(start_server, tmp_path, 'always')
+    assert log.stat().st_size == 100 * 4096    # nothing was cut
+
+
+# Retries a change until the server refuses it, as Shoal does once its log
+# failed, and returns the error.
+def refused(r, seconds):
+    deadline = time.time() + seconds
+    while time.time() < deadline:
+        try:
+            r.set('{t}k', 'v')
+        except redis.ResponseError as e:
+            return str(e)
+        time.sleep(0.1)
+    return None
+
+
+# Check that with --appendfsync always, after its log's writes fail, Shoal
+# refuses changes, on every shard, but still answers reads.
+def test_failing_log_always(start_server, tmp_path):
+    shoal_only(start_server)
+    srv = start_server('--appendfsync', 'always', '--dir', str(tmp_path),
+                       '--fail-log-after', '5')
+    r = redis.Redis(port=srv.address[1])
+    for i in range(5):
+        r.set(f'{{t}}k{i}', 'v')
+    # The sixth SET's commit fails, and its reply is an error.
+    with pytest.raises(redis.ResponseError, match="can't write the log"):
+        r.set('{t}k5', 'v')
+    assert 'not accepting changes' in refused(r, 5)
+    with pytest.raises(redis.ResponseError, match='not accepting changes'):
+        r.set('another key', 'v')
+    assert r.get('{t}k0') == b'v'
+    stop(srv)
+
+
+# Check that with --appendfsync everysec, Shoal goes on acknowledging
+# changes until a commit, once a second, fails, and then refuses them.
+def test_failing_log_everysec(start_server, tmp_path):
+    shoal_only(start_server)
+    srv = start_server('--dir', str(tmp_path), '--fail-log-after', '1')
+    r = redis.Redis(port=srv.address[1])
+    assert 'not accepting changes' in refused(r, 10)
+    stop(srv)

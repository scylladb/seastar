+// snippet: wait
+// WAIT numreplicas timeout: waits until a replica applied every change
+// made so far, on every shard, or until the timeout, in milliseconds
+// (0: no timeout), and returns how many replicas did: 0 or 1, since a
+// primary has at most one. With numreplicas 0, it doesn't wait. This waits
+// for changes that other clients made too, which Redis's WAIT doesn't.
+future<std::optional<reply>> wait(sharded<store>& db, request req,
+                                  abort_source&) {
+    auto replicas = parse_integer(req[1]);
+    auto ms = parse_integer(req[2]);
+    if (!replicas || !ms || *replicas < 0 || *ms < 0) {
+        co_return error_reply("value is not an integer or out of range");
+    }
+    if (db.local().replica) {
+        co_return error_reply("WAIT cannot be used with replica instances");
+    }
+    auto deadline = lowres_clock::now();
+    if (*replicas > 0) {
+        deadline = *ms ? deadline + std::chrono::milliseconds(*ms)
+                       : lowres_clock::time_point::max();
+    }
+    bool applied = co_await db.map_reduce0([deadline] (store& s) {
+        return s.feed ? s.feed->wait_for_replica(s.feed->end(), deadline)
+                      : make_ready_future<bool>(false);
+    }, true, std::logical_and<bool>());
+    co_return integer_reply(applied ? 1 : 0);
+}
+// end snippet: wait

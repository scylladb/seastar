+future<bool> replication_feed::wait_for_replica(
+        uint64_t offset, lowres_clock::time_point deadline) {
+    // A replica fetches from an offset only after it applied all the
+    // changes before it; but they include all the keys only after the
+    // snapshot that it started from.
+    try {
+        co_await _fetching.wait(deadline, [&] {
+            return _fetched >= std::max(offset, _synced);
+        });
+        co_return true;
+    } catch (condition_variable_timed_out&) {
+        co_return false;
+    }
+}

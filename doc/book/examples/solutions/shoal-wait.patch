+# Tests of WAIT, the solution of chapter 26's exercise 1.
+import time
+
+import pytest
+import redis
+
+from test_v14 import eventually, start_primary, start_replica
+
+
+# Check that WAIT returns 1 once the replica applied the changes, which
+# it then has.
+def test_wait(start_server):
+    _, p, port = start_primary(start_server)
+    _, r = start_replica(start_server, port)
+    for i in range(20):
+        p.set(f'wait:{i}', i)
+        assert p.wait(1, 10000) == 1
+        assert r.get(f'wait:{i}') == str(i).encode()
+
+
+# Check that a replica that just started, which gets the keys from a
+# snapshot, has them when WAIT returns. Valkey's WAIT returns 1 before
+# its new replica has keys that were written before it connected.
+def test_wait_after_sync(start_server):
+    if start_server.is_valkey:
+        pytest.skip("Valkey's WAIT doesn't wait for the snapshot")
+    _, p, port = start_primary(start_server)
+    p.mset({f'sync:{i}': i for i in range(10000)})
+    _, r = start_replica(start_server, port)
+    assert p.wait(1, 10000) == 1
+    assert r.dbsize() == 10000
+
+
+# Check that WAIT without a replica returns 0 after the timeout, and that
+# WAIT 0 doesn't wait.
+def test_wait_without_replica(start_server):
+    _, p, _ = start_primary(start_server)
+    p.set('alone', 'x')
+    start = time.time()
+    assert p.wait(1, 200) == 0
+    assert time.time() - start >= 0.19
+    assert p.wait(0, 0) == 0
+
+
+# Check that a replica refuses WAIT.
+def test_wait_on_replica(start_server):
+    _, p, port = start_primary(start_server)
+    _, r = start_replica(start_server, port)
+    with pytest.raises(redis.exceptions.ResponseError):
+        r.wait(1, 100)

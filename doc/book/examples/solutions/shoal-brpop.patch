+# Tests for the solution of chapter 10's exercise 1: BRPOP, which is BLPOP
+# popping from the end of the list. Like all of Shoal's tests, they pass
+# against Valkey too.
+import threading
+
+import redis
+
+from test_v6 import unique_key, wait_blocked
+
+
+# Starts BLPOP or BRPOP (pop is 'blpop' or 'brpop') on a connection of its
+# own, in a thread, and returns the thread and a list that receives the
+# reply.
+def pop_in_thread(server, pop, keys, timeout):
+    host, port = server
+    result = []
+    client = redis.Redis(host=host, port=port)
+
+    def run():
+        try:
+            result.append(getattr(client, pop)(keys, timeout))
+        finally:
+            client.close()
+    t = threading.Thread(target=run)
+    t.start()
+    return t, result
+
+
+# Check that BRPOP takes the last element at once, if the list has one.
+def test_brpop_immediate(r):
+    k = unique_key()
+    r.rpush(k, 'a', 'b')
+    assert r.brpop([k], 1) == (k.encode(), b'b')
+    assert r.lrange(k, 0, -1) == [b'a']
+
+
+# Check that BRPOP times out with nil.
+def test_brpop_timeout(r):
+    assert r.brpop([unique_key()], 0.1) is None
+
+
+# Check that when a client blocked in BRPOP and then one blocked in BLPOP
+# wait on the same key, a push of three elements gives the first the last
+# element, and the second the first element, and leaves the middle one.
+def test_brpop_then_blpop(r, server):
+    k = unique_key()
+    t1, result1 = pop_in_thread(server, 'brpop', [k], 5)
+    wait_blocked(r, 1)
+    t2, result2 = pop_in_thread(server, 'blpop', [k], 5)
+    wait_blocked(r, 2)
+    r.rpush(k, 'a', 'b', 'c')
+    t1.join()
+    t2.join()
+    assert result1 == [(k.encode(), b'c')]
+    assert result2 == [(k.encode(), b'a')]
+    assert r.lrange(k, 0, -1) == [b'b']
+
+
+# Check the same, with the client blocked in BLPOP first.
+def test_blpop_then_brpop(r, server):
+    k = unique_key()
+    t1, result1 = pop_in_thread(server, 'blpop', [k], 5)
+    wait_blocked(r, 1)
+    t2, result2 = pop_in_thread(server, 'brpop', [k], 5)
+    wait_blocked(r, 2)
+    r.rpush(k, 'a', 'b', 'c')
+    t1.join()
+    t2.join()
+    assert result1 == [(k.encode(), b'a')]
+    assert result2 == [(k.encode(), b'c')]
+    assert r.lrange(k, 0, -1) == [b'b']

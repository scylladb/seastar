@@ -0,0 +1,27 @@
+# Tests for the solution of chapter 25's exercise 2: GET /v1/config, which
+# returns Shoal's options, and rejects a query parameter it doesn't know.
+from test_v13 import admin_server, call
+
+
+# Check that /v1/config returns the options, among them those the server
+# was started with, and ?name= only the one named.
+def test_config(start_server):
+    r, api = admin_server(start_server, '--maxmemory', '100000000')
+    status, options = call(f'{api}/v1/config')
+    assert status == 200
+    config = {o['name']: o['value'] for o in options}
+    assert config['maxmemory'] == '100000000'
+    assert config['appendonly'] == 'yes'
+    assert int(config['port']) == r.connection_pool.connection_kwargs['port']
+    status, options = call(f'{api}/v1/config?name=maxmemory')
+    assert status == 200
+    assert options == [{'name': 'maxmemory', 'value': '100000000'}]
+
+
+# Check that an unknown query parameter gets 400 Bad Request, and an
+# unknown option's name 404 Not Found.
+def test_config_errors(start_server):
+    r, api = admin_server(start_server)
+    status, error = call(f'{api}/v1/config?nmae=maxmemory')
+    assert status == 400 and 'nmae' in error['message']
+    assert call(f'{api}/v1/config?name=nothing')[0] == 404

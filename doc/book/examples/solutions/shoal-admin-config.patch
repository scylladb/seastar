+// snippet: get-config
+// GET /v1/config?name=...: Shoal's options, or only the one named. Seastar
+// checks only that the parameters that an operation requires are there,
+// so a parameter that it doesn't know, perhaps misspelled, is rejected
+// here, rather than ignored.
+future<json::json_return_type> get_config(const config_list& config,
+                                          const http::request& req) {
+    for (auto& [param, values] : req.get_query_params()) {
+        if (param != "name") {
+            throw httpd::bad_param_exception(
+                fmt::format("unknown parameter '{}'", param));
+        }
+    }
+    auto name = req.get_query_param("name");
+    std::vector<aj::option> options;
+    for (auto& [n, v] : config) {
+        if (name.empty() || n == name) {
+            aj::option o;
+            o.name = n;
+            o.value = v;
+            options.push_back(std::move(o));
+        }
+    }
+    if (!name.empty() && options.empty()) {
+        throw httpd::not_found_exception(
+            fmt::format("no option '{}'", name));
+    }
+    return make_ready_future<json::json_return_type>(std::move(options));
+}
+// end snippet: get-config

+
+// snippet: blpop-test
+// BLPOP waits for a key, until LPUSH, on another "connection", pushes to
+// it. The test waits until the BLPOP is blocked before it pushes:
+// otherwise the LPUSH might come first, and BLPOP would find the element
+// at once, without waiting, which isn't what we test. BLPOP counts itself
+// as blocked, on the shard of its client, this one, only after it's in
+// the key's line of waiting clients.
+SEASTAR_FIXTURE_TEST_CASE(test_blpop_wakes_up, shoal_fixture) {
+    auto waiting = run({"BLPOP", "list", "0"});
+    while (db.local().blocked_clients == 0) {
+        co_await yield();
+    }
+    BOOST_REQUIRE(!waiting.available());
+    BOOST_REQUIRE_EQUAL(co_await run({"LPUSH", "list", "x"}), ":1\r\n");
+    BOOST_REQUIRE_EQUAL(co_await std::move(waiting),
+                        "*2\r\n$4\r\nlist\r\n$1\r\nx\r\n");
+}
+// end snippet: blpop-test

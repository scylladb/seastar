--- /dev/null
+++ b/test_solutions.py
@@ -0,0 +1,52 @@
+# Tests for the solution of chapter 15's exercise 2: PUBLISH visits only
+# the shards that have subscribers to its channel, which every shard learns
+# when another gets its first subscriber to a channel, or loses its last.
+# Like all of Shoal's tests, they pass against Valkey too.
+import redis
+
+from test_v8 import unique_key
+
+
+# Subscribes a new client, on a connection of its own, to a channel, and
+# returns it after the server confirmed.
+def subscriber(server, channel):
+    host, port = server
+    p = redis.Redis(host=host, port=port).pubsub()
+    p.subscribe(channel)
+    assert p.get_message(timeout=5)['type'] == 'subscribe'
+    return p
+
+
+# Check that a PUBLISH right after a client's subscription is confirmed
+# reaches it, whichever shard the client is on, again and again.
+def test_publish_right_after_subscribe(r, server):
+    for _ in range(20):
+        channel = unique_key()
+        others = [subscriber(server, unique_key()) for _ in range(3)]
+        p = subscriber(server, channel)
+        try:
+            assert r.publish(channel, 'hello') == 1
+            m = p.get_message(timeout=5)
+            assert m['type'] == 'message' and m['data'] == b'hello'
+        finally:
+            p.close()
+            for o in others:
+                o.close()
+
+
+# Check that subscribers who come and go are counted right: a channel
+# whose subscribers all left has none, and one that has new ones counts
+# them all.
+def test_subscribers_come_and_go(r, server):
+    channel = unique_key()
+    first = [subscriber(server, channel) for _ in range(4)]
+    assert r.publish(channel, 'a') == 4
+    for p in first:
+        assert p.get_message(timeout=5)['data'] == b'a'
+        p.unsubscribe(channel)
+        assert p.get_message(timeout=5)['type'] == 'unsubscribe'
+    assert r.publish(channel, 'b') == 0
+    second = [subscriber(server, channel) for _ in range(3)]
+    assert r.publish(channel, 'c') == 3
+    for p in first + second:
+        p.close()

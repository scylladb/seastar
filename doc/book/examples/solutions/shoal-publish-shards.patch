+// snippet: tell-all
+future<> pubsub::tell_all(const sstring& channel, bool subscribed) {
+    unsigned shard = this_shard_id();
+    uint64_t version = ++_version;
+    return container().invoke_on_all(
+            [channel, shard, version, subscribed] (pubsub& ps) {
+        ps.learn(channel, shard, version, subscribed);
+    });
+}
+
+void pubsub::learn(const sstring& channel, unsigned shard, uint64_t version,
+                   bool subscribed) {
+    auto& shards = _channel_shards[channel];
+    auto it = shards.find(shard);
+    if (it != shards.end() && it->second >= version) {
+        return;         // older than what we know
+    }
+    if (subscribed) {
+        shards[shard] = version;
+    } else {
+        // A later "subscribed", if one comes, has a higher version, so
+        // forgetting this one's version is safe.
+        shards.erase(shard);
+        if (shards.empty()) {
+            _channel_shards.erase(channel);
+        }
+    }
+}
+// end snippet: tell-all

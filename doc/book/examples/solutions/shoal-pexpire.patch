+# Tests for the solution of chapter 9's exercise 1: PEXPIRE and PTTL,
+# which are EXPIRE and TTL in milliseconds. Like all of Shoal's tests,
+# they pass against Valkey too.
+import time
+
+import pytest
+import redis
+
+from test_v5 import unique_key
+
+
+# Check that PTTL is -2 for a key that doesn't exist, and -1 for a key
+# that has no expiration time.
+def test_pttl_without_expiration(r):
+    k = unique_key()
+    assert r.pttl(k) == -2
+    r.set(k, 'v')
+    assert r.pttl(k) == -1
+
+
+# Check that PEXPIRE sets an expiration time, which PTTL reports in
+# milliseconds, and TTL in seconds.
+def test_pexpire_and_pttl(r):
+    k = unique_key()
+    r.set(k, 'v')
+    assert r.pexpire(k, 100000) is True
+    assert 99000 < r.pttl(k) <= 100000
+    assert r.ttl(k) == 100
+
+
+# Check that PTTL reports, in milliseconds, an expiration time that
+# EXPIRE set in seconds.
+def test_expire_then_pttl(r):
+    k = unique_key()
+    r.set(k, 'v')
+    r.expire(k, 100)
+    assert 99000 < r.pttl(k) <= 100000
+
+
+# Check that PEXPIRE of a key that doesn't exist returns 0, and doesn't
+# create the key.
+def test_pexpire_missing_key(r):
+    k = unique_key()
+    assert r.pexpire(k, 1000) is False
+    assert r.exists(k) == 0
+
+
+# Check that a key disappears when the expiration time that PEXPIRE set
+# passes.
+def test_pexpire_key_expires(r):
+    k = unique_key()
+    r.set(k, 'v')
+    assert r.pexpire(k, 200) is True
+    assert r.get(k) == b'v'
+    time.sleep(0.4)
+    assert r.get(k) is None
+    assert r.pttl(k) == -2
+
+
+# Check that PEXPIRE with zero or a negative time deletes the key at once.
+def test_pexpire_non_positive_deletes(r):
+    k1 = unique_key()
+    k2 = unique_key()
+    r.set(k1, 'v')
+    r.set(k2, 'v')
+    assert r.pexpire(k1, 0) is True
+    assert r.pexpire(k2, -5) is True
+    assert r.exists(k1, k2) == 0
+
+
+# Check that PEXPIRE rejects a time that isn't an integer, and that both
+# commands check their number of arguments.
+def test_pexpire_pttl_errors(r):
+    k = unique_key()
+    r.set(k, 'v')
+    with pytest.raises(redis.ResponseError, match='not an integer'):
+        r.execute_command('PEXPIRE', k, 'soon')
+    with pytest.raises(redis.ResponseError, match='wrong number of arguments'):
+        r.execute_command('PEXPIRE', k)
+    with pytest.raises(redis.ResponseError, match='wrong number of arguments'):
+        r.execute_command('PTTL')
+    assert r.pttl(k) == -1

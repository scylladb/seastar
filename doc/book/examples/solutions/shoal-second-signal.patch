+    // Stop when the user presses Ctrl-C (SIGINT), or kill sends SIGTERM. A
+    // second signal, while stopping, gives up on the connections at once,
+    // without waiting for the grace period. Seastar can't remove a signal
+    // handler, so before db is destroyed, replace these with handlers that
+    // do nothing.
+    auto on_signal = [&db] {
+        if (!db.stopping.abort_requested()) {
+            db.stopping.request_abort();
+        } else if (!db.giving_up.abort_requested()) {
+            shoal_log.info("a second signal: giving up on the connections "
+                           "still open");
+            db.giving_up.request_abort();
+        }
+    };
+    handle_signal(SIGINT, on_signal);
+    handle_signal(SIGTERM, on_signal);

@@ -0,0 +1,31 @@
+# Tests for the solution of chapter 12's exercise 4: a second SIGINT or
+# SIGTERM, while the server stops, gives up on the connections at once.
+# ./run gives Shoal a grace period of a second; Valkey doesn't wait at
+# all. Like all of Shoal's tests, they pass against Valkey too.
+import signal
+import socket
+import time
+
+import pytest
+import redis
+
+from test_v7 import command
+
+
+# Check that a second signal stops a server that waits for a client that
+# doesn't read its replies, well before the grace period ends.
+@pytest.mark.parametrize('how', ['SIGINT', 'SIGTERM'])
+def test_second_signal_gives_up(own_server, how):
+    address = own_server.address
+    r = redis.Redis(*address)
+    r.set('test_stop_big', 'x' * 1000000)
+    # 100 replies of a megabyte each are far more than the sockets' buffers
+    # hold, so the server can't send them all.
+    lazy = socket.create_connection(address, timeout=10)
+    lazy.sendall(command('GET', 'test_stop_big') * 100)
+    r.ping()
+    own_server.process.send_signal(getattr(signal, how))
+    time.sleep(0.1)
+    own_server.process.send_signal(getattr(signal, how))
+    assert own_server.process.wait(timeout=0.7) == 0
+    lazy.close()

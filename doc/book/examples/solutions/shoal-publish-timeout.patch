+// snippet: disconnect-slowest
+void pubsub::disconnect_slowest() {
+    client* slowest = nullptr;
+    for (auto& [channel, subscribers] : _channels) {
+        for (client* s : subscribers) {
+            if (!slowest || s->pending() > slowest->pending()) {
+                slowest = s;
+            }
+        }
+    }
+    if (slowest) {
+        shoal_log.warn("a publisher waited too long: disconnecting the "
+                       "subscriber with {} bytes of unsent messages",
+                       slowest->pending());
+        forget(*slowest);
+        slowest->disconnect();
+    }
+}
+// end snippet: disconnect-slowest
+
 void pubsub::forget(client& c) {
     std::vector<sstring> all(c.channels().begin(), c.channels().end());
     for (auto& channel : all) {
@@ -228,8 +250,20 @@
     if (auto it = _channels.find(channel); it != _channels.end()) {
         subscribers = it->second.size();
     }
-    auto units = co_await get_units(
-        _memory, std::min(cost * subscribers, _memory_limit));
+    // Don't wait forever: when the wait takes longer than a second,
+    // disconnect the subscriber that is furthest behind, whose messages
+    // hold the units, and wait again.
+    semaphore_units<> units;
+    while (true) {
+        try {
+            units = co_await get_units(
+                _memory, std::min(cost * subscribers, _memory_limit),
+                std::chrono::seconds(1));
+            break;
+        } catch (semaphore_timed_out&) {
+            disconnect_slowest();
+        }
+    }
     // While we waited, clients may have subscribed or unsubscribed, so look

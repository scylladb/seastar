+# Tests for the solutions of chapter 4's exercises 1 and 2: INCR and APPEND.
+# Like all of Shoal's tests, they pass against Valkey too.
+import pytest
+import redis
+
+from test_v1 import unique_key
+
+
+# Check that INCR starts a missing key at 0, and adds 1 each time.
+def test_incr(r):
+    key = unique_key()
+    assert r.execute_command('INCR', key) == 1
+    assert r.execute_command('INCR', key) == 2
+    assert r.get(key) == b'2'
+
+
+# Check that INCR works on a value that SET stored, negative ones too.
+def test_incr_existing(r):
+    key = unique_key()
+    r.set(key, '-5')
+    assert r.execute_command('INCR', key) == -4
+
+
+# Check that INCR refuses a value that isn't an integer, and leaves it alone.
+@pytest.mark.parametrize('value', ['abc', '1.5', ' 1', '1 ', '',
+                                   '99999999999999999999'])
+def test_incr_not_integer(r, value):
+    key = unique_key()
+    r.set(key, value)
+    message = 'value is not an integer or out of range'
+    with pytest.raises(redis.ResponseError, match=message):
+        r.execute_command('INCR', key)
+    assert r.get(key) == value.encode()
+
+
+# Check that INCR refuses to go past the largest 64-bit integer.
+def test_incr_overflow(r):
+    key = unique_key()
+    r.set(key, str(2**63 - 1))
+    message = 'increment or decrement would overflow'
+    with pytest.raises(redis.ResponseError, match=message):
+        r.execute_command('INCR', key)
+
+
+# Check that APPEND creates a missing key, appends to an existing one, and
+# replies with the new length.
+def test_append(r):
+    key = unique_key()
+    assert r.append(key, 'hello') == 5
+    assert r.append(key, ' world') == 11
+    assert r.get(key) == b'hello world'

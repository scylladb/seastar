+// snippet: incr
+// INCR key: adds 1 to the integer at key, which starts at 0 if key doesn't
+// exist.
+sstring incr(store& db, const request& req) {
+    int64_t n = 0;
+    if (auto it = db.find(req[1]); it != db.end()) {
+        auto& value = it->second;
+        auto [end, err] = std::from_chars(value.begin(), value.end(), n);
+        if (err != std::errc() || end != value.end()) {
+            return error_reply("value is not an integer or out of range");
+        }
+    }
+    if (n == std::numeric_limits<int64_t>::max()) {
+        return error_reply("increment or decrement would overflow");
+    }
+    db.insert_or_assign(req[1], fmt::format("{}", n + 1));
+    return integer_reply(n + 1);
+}
+// end snippet: incr
+
+// snippet: append
+// APPEND key value: appends value to the string at key, and replies with
+// its new length.
+sstring append(store& db, const request& req) {
+    auto& value = db[req[1]];
+    value.append(req[2].data(), req[2].size());
+    return integer_reply(value.size());
+}
+// end snippet: append

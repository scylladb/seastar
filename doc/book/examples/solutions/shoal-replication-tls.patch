@@ -0,0 +1,67 @@
+# Tests of the solution of chapter 26's exercise 3: replication over TLS.
+import shutil
+import subprocess
+import time
+
+import pytest
+import redis
+
+from test_v9 import make_certificate
+from test_v14 import eventually, same_keys, start_primary
+
+
+@pytest.fixture
+def certificates(tmp_path):
+    """A certificate authority, certificates that it signed for a primary
+    and for a replica, and a certificate that it didn't sign."""
+    ca = make_certificate(tmp_path, 'ca', is_ca=True)
+    return (ca, make_certificate(tmp_path, 'primary', ca),
+            make_certificate(tmp_path, 'replica', ca),
+            make_certificate(tmp_path, 'stranger'))
+
+
+def tls_options(certificate, ca):
+    return ('--tls-replication', 'yes', '--tls-cert-file', certificate[0],
+            '--tls-key-file', certificate[1], '--tls-ca-cert-file', ca[0])
+
+
+def start_tls_replica(start_server, port, *options):
+    # The certificates are for localhost, the name that the replica checks.
+    replica = start_server('--replicaof', f'localhost:{port}', *options)
+    return redis.Redis(port=replica.address[1])
+
+
+def bytes_received_from(port):
+    """The bytes that the sockets connected to port received."""
+    out = subprocess.run(['ss', '-tinH', 'dst', f'127.0.0.1:{port}'],
+                         capture_output=True, text=True, check=True).stdout
+    return sum(int(word.split(':')[1]) for word in out.split()
+               if word.startswith('bytes_received:'))
+
+
+# Check that a replica with a certificate that the primary trusts copies
+# its keys over TLS, compressed.
+def test_tls(start_server, certificates):
+    if start_server.is_valkey:
+        pytest.skip("Valkey's replication over TLS uses its TLS port")
+    ca, primary, replica, _ = certificates
+    _, p, port = start_primary(start_server, *tls_options(primary, ca))
+    p.mset({f'tls:{i}': 'x' * 100 for i in range(10000)})
+    r = start_tls_replica(start_server, port, *tls_options(replica, ca))
+    eventually(lambda: same_keys(p, r))
+    # The values alone are a megabyte, but they compress very well.
+    if shutil.which('ss'):
+        assert bytes_received_from(port) < 250000
+
+
+# Check that the primary refuses a replica whose certificate it doesn't
+# trust.
+def test_tls_untrusted(start_server, certificates):
+    if start_server.is_valkey:
+        pytest.skip("Valkey's replication over TLS uses its TLS port")
+    ca, primary, _, stranger = certificates
+    _, p, port = start_primary(start_server, *tls_options(primary, ca))
+    p.set('secret', 'x')
+    r = start_tls_replica(start_server, port, *tls_options(stranger, ca))
+    time.sleep(1.5)
+    assert r.dbsize() == 0

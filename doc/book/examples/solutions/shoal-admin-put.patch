+// snippet: set-key
+// Sets a key to a value, by executing SET, which also logs it, and counts
+// its memory, as a client's SET would.
+future<> set_key(sharded<store>& db, sstring key, sstring value) {
+    abort_source never;
+    auto r = co_await execute(db, request{"SET", std::move(key),
+                                          std::move(value)}, never);
+    auto& text = std::get<sstring>(*r);
+    if (text.starts_with("-")) {
+        // An error reply, "-ERR ...\r\n", without the "-" and "\r\n".
+        throw std::runtime_error(text.substr(1, text.size() - 3));
+    }
+}
+// end snippet: set-key

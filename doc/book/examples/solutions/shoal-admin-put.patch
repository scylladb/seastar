+// snippet: put-key
+// PUT /v1/keys/{key}: sets the key to the request's body, which it reads
+// from the request's stream. The server has already rejected a body whose
+// Content-Length is larger than max_body, but a chunked body has none, so
+// this checks the length again as it reads.
+future<json::json_return_type> put_key(sharded<store>& db,
+                                       std::unique_ptr<http::request> req) {
+    sstring value;
+    while (auto buf = co_await req->content_stream->read()) {
+        if (value.size() + buf.size() > max_body) {
+            throw httpd::base_exception(
+                fmt::format("a value may have at most {} bytes", max_body),
+                http::reply::status_type::payload_too_large);
+        }
+        value.append(buf.get(), buf.size());
+    }
+    co_await set_key(db, req->get_path_param("key"), std::move(value));
+    co_return json::json_void();
+}
+// end snippet: put-key

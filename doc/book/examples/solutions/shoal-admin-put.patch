@@ -0,0 +1,54 @@
+# Tests for the solution of chapter 25's exercise 1: PUT /v1/keys/{key},
+# which sets a key to the request's body, of at most a megabyte.
+import http.client
+import urllib.error
+import urllib.parse
+import urllib.request
+
+from test_v13 import admin_server, call
+
+
+# Sends a PUT with a body, which is sent chunked, without a Content-Length,
+# if it's an iterable of pieces; returns the HTTP status.
+def put(url, body):
+    request = urllib.request.Request(url, data=body, method='PUT')
+    try:
+        with urllib.request.urlopen(request, timeout=10) as reply:
+            return reply.status
+    except urllib.error.HTTPError as e:
+        return e.code
+
+
+# Check that PUT sets the key, for Redis clients too, and replaces an old
+# value.
+def test_put(start_server):
+    r, api = admin_server(start_server)
+    assert put(f'{api}/v1/keys/put1', b'hello') == 200
+    assert r.get('put1') == b'hello'
+    assert put(f'{api}/v1/keys/put1', b'x' * 100_000) == 200
+    assert r.get('put1') == b'x' * 100_000
+
+
+# Check that a request that says its body has a gigabyte gets 413 Payload
+# Too Large at once, before it sends the body.
+def test_put_gigabyte(start_server):
+    r, api = admin_server(start_server)
+    url = urllib.parse.urlsplit(f'{api}/v1/keys/put2')
+    conn = http.client.HTTPConnection(url.hostname, url.port, timeout=10)
+    conn.putrequest('PUT', url.path)
+    conn.putheader('Content-Length', str(1024 ** 3))
+    conn.endheaders()
+    assert conn.getresponse().status == 413
+    conn.close()
+    assert r.exists('put2') == 0
+
+
+# Check that a chunked body, which has no Content-Length, gets 413 Payload
+# Too Large when it grows over a megabyte, and sets nothing, while a
+# megabyte exactly is allowed.
+def test_put_chunked(start_server):
+    r, api = admin_server(start_server)
+    assert put(f'{api}/v1/keys/put3', iter([b'x' * 65536] * 17)) == 413
+    assert r.exists('put3') == 0
+    assert put(f'{api}/v1/keys/put3', iter([b'x' * 65536] * 16)) == 200
+    assert len(r.get('put3')) == 1024 * 1024

-// GET /v1/keys?pattern=...: the matching keys, as a JSON array, which is
-// written to the connection a key at a time, rather than built whole.
+// Writes the keys that match a pattern, as a JSON array, asking one shard
+// at a time, so that only one shard's keys are in memory at once.
+future<> write_keys(sharded<store>& db, sstring pattern,
+                    output_stream<char> out) {
+    std::exception_ptr error;
+    try {
+        co_await out.write("[");
+        bool first = true;
+        for (unsigned shard = 0; shard < this_smp_shard_count(); shard++) {
+            auto keys = co_await keys_on(db, shard, pattern);
+            for (auto& key : keys) {
+                if (!first) {
+                    co_await out.write(", ");
+                }
+                first = false;
+                co_await json::formatter::write(out, key);
+            }
+        }
+        co_await out.write("]");
+    } catch (...) {
+        error = std::current_exception();
+    }
+    co_await out.close();
+    if (error) {
+        std::rethrow_exception(error);
+    }
+}
+
+// GET /v1/keys?pattern=...: the matching keys, written by write_keys().
 future<json::json_return_type> get_keys(sharded<store>& db,
                                         std::unique_ptr<http::request> req) {
     auto pattern = req->get_query_param("pattern", "*");
-    auto keys = co_await matching_keys(db, std::move(pattern));
-    co_return json::stream_range_as_array(std::move(keys),
-                                          [] (const sstring& key) {
-        return key;
+    // The lambda only calls a coroutine function, and gives it copies.
+    co_return json::json_return_type::body_writer_type(
+            [&db, pattern] (output_stream<char>&& out) {
+        return write_keys(db, pattern, std::move(out));
     });
 }
 // end snippet: get-keys

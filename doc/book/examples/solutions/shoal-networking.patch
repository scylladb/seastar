+++ b/test_solutions.py
@@ -0,0 +1,37 @@
+# Tests of the solution to chapter 16's exercise 2. Like all of Shoal's
+# tests, they pass against Valkey too.
+import socket
+import uuid
+
+import redis
+
+from test_v9 import command
+
+
+def unique_key():
+    return 'key-' + uuid.uuid4().hex
+
+
+# Check that a pipeline with a command that is executed alone in its
+# middle, all sent before any reply is read, gets all its replies. Before
+# the DBSIZE, the replies are more than the sockets can hold; after it,
+# the requests are.
+def test_huge_pipeline_with_dbsize(server):
+    r = redis.Redis(host=server[0], port=server[1])
+    key, other = unique_key(), unique_key()
+    value, big = b'v' * 10_000, b'w' * 100_000
+    r.set(key, value)
+    pipeline = (command('GET', key) * 1000 + command('DBSIZE')
+                + command('SET', other, big) * 1000)
+    get_reply = b'$%d\r\n%s\r\n' % (len(value), value)
+    with socket.create_connection(server, timeout=30) as s:
+        s.sendall(pipeline)
+        expected = len(get_reply) * 1000
+        data = b''
+        while len(data) < expected or not data.endswith(b'+OK\r\n' * 1000):
+            more = s.recv(1 << 20)
+            assert more, 'the server closed the connection'
+            data += more
+    assert data[:expected] == get_reply * 1000
+    assert data[expected:].startswith(b':')
+    r.delete(key, other)

+// snippet: run-log
+// The longest gap between two timer functions in one run.
+constexpr auto run_gap = std::chrono::microseconds(50);
+
+// Logs the current run of timer functions, if it has ended, by now.
+void log_run(store& db, std::chrono::steady_clock::time_point now) {
+    if (db.run.functions && now - db.run.last > run_gap) {
+        std::chrono::duration<double, std::milli> took =
+            db.run.last - db.run.start;
+        shoal_log.info("{} timer functions in a row, in {:.1f} ms",
+                       db.run.functions, took.count());
+        db.run.functions = 0;
+    }
+}
+
+// Notes that a timer function ran, for the log.
+void note_timer_function(store& db) {
+    auto now = std::chrono::steady_clock::now();
+    log_run(db, now);
+    if (db.run.functions++ == 0) {
+        db.run.start = now;
+    }
+    db.run.last = now;
+}
+// end snippet: run-log

@@ -0,0 +1,55 @@
+# Tests for the solution of exercise 5 of "Scheduling groups": the log is
+# rewritten by itself when it has grown by --auto-aof-rewrite-percentage
+# since its last rewrite, and is at least --auto-aof-rewrite-min-size.
+import time
+
+import redis
+
+
+def start(start_server, tmp_path, *options):
+    options = [*options, '--dir', str(tmp_path)]
+    if start_server.is_valkey:
+        options += ['--appendonly', 'yes']
+    srv = start_server(*options)
+    return srv, redis.Redis(port=srv.address[1])
+
+
+def wait_for_rewrite(r):
+    deadline = time.time() + 60
+    while r.info('persistence')['aof_rewrite_in_progress']:
+        assert time.time() < deadline
+        time.sleep(0.01)
+
+
+# Check that a log that keeps growing, here with 3,000 values of a
+# kilobyte written to one key, is rewritten by itself, and so stays small.
+def test_auto_rewrite(start_server, tmp_path):
+    min_size = 65536
+    srv, r = start(start_server, tmp_path,
+                   '--auto-aof-rewrite-percentage', '100',
+                   '--auto-aof-rewrite-min-size', str(min_size))
+    value = 'x' * 1000
+    for i in range(3000):
+        r.set('key', f'{i} {value}')
+    time.sleep(0.5)     # Valkey checks the log's growth periodically
+    wait_for_rewrite(r)
+    info = r.info('persistence')
+    # A rewrite happened (the base size is the log's size after the last
+    # one, with the changes made during it), the log is smaller than all
+    # that was written to it, and no rewrite is due.
+    assert info['aof_base_size'] > 0
+    assert info['aof_current_size'] < 3000 * 1000
+    assert info['aof_current_size'] < 2 * info['aof_base_size'] + min_size
+    assert r.get('key') == f'2999 {value}'.encode()
+
+
+# Check that with --auto-aof-rewrite-percentage 0, the log isn't rewritten
+# by itself: it holds all the values written to the key.
+def test_no_auto_rewrite(start_server, tmp_path):
+    srv, r = start(start_server, tmp_path,
+                   '--auto-aof-rewrite-percentage', '0')
+    value = 'x' * 1000
+    for i in range(300):
+        r.set('key', f'{i} {value}')
+    time.sleep(1.5)     # until a commit, once a second, has written them
+    assert r.info('persistence')['aof_current_size'] > 300 * 1000

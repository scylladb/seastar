 // Records a change in the shard's log: the request that, executed again
 // when Shoal starts, makes the same change. While Shoal replays the log,
 // the store has no log yet, so replaying records nothing.
+// snippet: maybe-rewrite
+// Exercise 5: starts a rewrite when the log has grown enough, as Redis's
+// auto-aof-rewrite-percentage and auto-aof-rewrite-min-size do.
+void maybe_rewrite(store& db) {
+    if (!db.auto_rewrite_percentage || db.rewrite_in_progress || !db.log) {
+        return;
+    }
+    auto size = db.log->size();
+    if (size >= db.auto_rewrite_min_size &&
+        size >= db.base_size * (100 + db.auto_rewrite_percentage) / 100) {
+        db.start_rewrite();
+    }
+}
+// end snippet: maybe-rewrite

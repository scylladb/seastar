+// snippet: scan
+// SCAN cursor [MATCH pattern] [COUNT count]. The cursor says where to
+// continue: in its lowest 8 bits, the shard (so Shoal may have at most 256
+// shards); in the next 32, a bucket of that shard's hash table; and in the
+// highest 24, the low bits of the number of buckets that the table had
+// then. If the table has grown since, its keys have moved, and the shard
+// is scanned again from its first bucket: some keys may be returned
+// twice, which SCAN allows, but none that existed all along is missed.
+struct scan_cursor {
+    unsigned shard = 0;
+    size_t bucket = 0;
+    uint64_t buckets_tag = 0;
+    static constexpr uint64_t tag_mask = (uint64_t(1) << 24) - 1;
+    static scan_cursor decode(uint64_t c) {
+        return {unsigned(c & 0xff), size_t((c >> 8) & 0xffffffff), c >> 40};
+    }
+    uint64_t encode() const {
+        return shard | (uint64_t(bucket) << 8) | (buckets_tag << 40);
+    }
+};
+
+// What one shard found: its keys, and where to continue on it, if it
+// hasn't been scanned to the end.
+struct scan_result {
+    std::vector<sstring> keys;
+    std::optional<scan_cursor> next;
+};
+
+// Scans this shard's buckets, from the cursor's, until it finds count
+// keys, or reaches the end of the table.
+scan_result scan_here(store& db, scan_cursor c, const sstring& pattern,
+                      size_t count) {
+    size_t buckets = db.data.bucket_count();
+    uint64_t tag = buckets & scan_cursor::tag_mask;
+    if (c.bucket != 0 && c.buckets_tag != tag) {
+        c.bucket = 0;           // the table has grown: start again
+    }
+    scan_result result;
+    size_t b = c.bucket;
+    for (; b < buckets && result.keys.size() < count; b++) {
+        for (auto it = db.data.begin(b); it != db.data.end(b); ++it) {
+            if (glob_match(pattern, it->first) && !expired(it->second)) {
+                result.keys.push_back(it->first);
+            }
+        }
+    }
+    if (b < buckets) {
+        result.next = scan_cursor{c.shard, b, tag};
+    }
+    return result;
+}
+
+future<std::optional<sstring>> scan(sharded<store>& db, request req,
+                                    abort_source&) {
+    uint64_t cursor;
+    auto [end, error] = std::from_chars(req[1].data(),
+                                        req[1].data() + req[1].size(), cursor);
+    if (error != std::errc() || end != req[1].data() + req[1].size()) {
+        co_return error_reply("invalid cursor");
+    }
+    sstring pattern = "*";
+    size_t count = 10;
+    for (size_t i = 2; i < req.size(); i += 2) {
+        auto option = lowercase(req[i]);
+        if (i + 1 == req.size() || (option != "match" && option != "count")) {
+            co_return error_reply("syntax error");
+        }
+        if (option == "match") {
+            pattern = req[i + 1];
+        } else {
+            auto n = parse_integer(req[i + 1]);
+            if (!n || *n < 1) {
+                co_return error_reply("syntax error");
+            }
+            count = *n;
+        }
+    }
+    auto c = scan_cursor::decode(cursor);
+    if (c.shard >= this_smp_shard_count()) {
+        co_return error_reply("invalid cursor");
+    }
+    auto result = co_await db.invoke_on(c.shard, [&] (store& s) {
+        return scan_here(s, c, pattern, count);
+    });
+    // Continue on this shard, or on the next one, or, after the last one,
+    // tell the client that it's done, with the cursor 0.
+    uint64_t next = 0;
+    if (result.next) {
+        next = result.next->encode();
+    } else if (c.shard + 1 < this_smp_shard_count()) {
+        next = scan_cursor{c.shard + 1, 0, 0}.encode();
+    }
+    std::string reply = array_header_reply(2)
+        + bulk_string_reply(to_sstring(next))
+        + array_header_reply(result.keys.size());
+    for (auto& key : result.keys) {
+        reply += bulk_string_reply(key);
+    }
+    co_return sstring(reply);
+}
+// end snippet: scan

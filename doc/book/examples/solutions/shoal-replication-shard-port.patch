+// snippet: local-address
+// An address from which to connect to the primary, whose port lands the
+// connection on the primary's shard of this shard's number: a random port
+// of Linux's usual range for outgoing connections, 32768 to 60999, whose
+// remainder, divided by the number of shards, is this shard's number.
+// Should the port be in use, connecting fails, and call() tries again,
+// with another.
+socket_address replica::local_address() {
+    static thread_local std::minstd_rand random(std::random_device{}());
+    unsigned shards = this_smp_shard_count();
+    std::uniform_int_distribution<unsigned> range(32768 / shards + 1,
+                                                  60999 / shards - 1);
+    uint16_t port = range(random) * shards + this_shard_id();
+    auto any = _primary.family() == AF_INET6 ? net::inet_address("::")
+                                             : net::inet_address("0.0.0.0");
+    return socket_address(any, port);
+}
+// end snippet: local-address

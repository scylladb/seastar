+# Tests of the solution of chapter 26's exercise 2: each of a replica's
+# connections lands on the primary's shard that it's about.
+import socket
+
+import pytest
+
+from test_v14 import eventually, same_keys, start_primary, start_replica
+
+
+# Check that the replica's requests were never passed to another shard,
+# even after another connection made the primary's shards' counts of
+# connections unequal, which is what decides where a connection goes
+# without the solution.
+def test_no_forwarding(start_server):
+    if start_server.is_valkey:
+        pytest.skip('Valkey has no shards')
+    _, p, port = start_primary(start_server)
+    p.mset({f'port:{i}': i for i in range(1000)})
+    with socket.create_connection(('127.0.0.1', port)):
+        _, r = start_replica(start_server, port)
+        eventually(lambda: same_keys(p, r))
+        p.set('port:new', 'x')
+        eventually(lambda: r.get('port:new') == b'x')
+    assert p.info('replication')['repl_forwarded'] == 0

+# Tests for the solution of chapter 5's exercise 5: FLUSHALL ASYNC replies
+# at once, and destroys the old data in the background. Like all of
+# Shoal's tests, they pass against Valkey too.
+from test_v1 import unique_key
+
+
+# Check that FLUSHALL ASYNC deletes the keys, and that a key set right
+# after it survives: only the keys that existed when it was invoked are
+# deleted.
+def test_flushall_async_keeps_new_keys(r):
+    old, new = unique_key(), unique_key()
+    pipe = r.pipeline(transaction=False)
+    for i in range(10000):
+        pipe.set(f'{old}-{i}', 'x')
+    pipe.execute()
+    assert r.execute_command('FLUSHALL', 'ASYNC') in (True, b'OK')
+    r.set(new, 'kept')
+    assert r.get(f'{old}-0') is None
+    assert r.get(new) == b'kept'

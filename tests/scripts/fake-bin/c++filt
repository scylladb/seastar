"""
Stand-in for `c++filt -p` which drops the parameter lists of function names.

Reads the output of fake-bin/llvm-addr2line line by line and removes the
parenthesised parameter list following the function name of every frame,
e.g. "func_12(char const*) at gib/ber.cc:18" becomes "func_12 at gib/ber.cc:18".
Other lines are copied unchanged.
"""

import re
import sys

frame = re.compile(r'^(.*?\S)\([^()]*\)( at .*)$', re.S)

for line in sys.stdin:
    print(frame.sub(r'\1\2', line), end='', flush=True)

"""
Stand-in for file(1) which describes the given files by their first bytes.

Prints "<path>: ELF executable, stripped" for files starting with the ELF
magic, "<path>: data" for other files and a "cannot open" message for
missing ones, always exiting with 0 the same as file(1) does.
"""

import sys

for path in sys.argv[1:]:
    try:
        with open(path, 'rb') as f:
            magic = f.read(4)
    except OSError as e:
        print(f"{path}: cannot open `{path}' ({e.strerror})")
        continue
    print(f'{path}: ELF executable, stripped' if magic == b'\x7fELF' else f'{path}: data')
